# ── Movie Data Provider ──────────────────────────────────────────────
# Choose: "auto" | "omdb" | "reeldb" | "tmdb"
# "auto" picks the first configured key: ReelDB → OMDb → TMDB
MOVIE_PROVIDER=auto

# Region for streaming availability (ISO 3166-1, e.g. US, IN, GB)
MOVIE_REGION=IN

# ── Option 1: OMDb (EASIEST — just email signup) ─────────────────────
# Get free key: https://www.omdbapi.com/apikey.aspx
# Select "FREE" tier (1,000 requests/day) → verify email → copy key
OMDB_API_KEY=your_omdb_api_key_here

# ── Option 2: ReelDB (BEST alternative — movies + streaming) ─────────
# Get free key: https://reeldb.io/ (Patreon signup, often easier than TMDB)
REELDB_API_KEY=your_reeldb_api_key_here

# ── Option 3: TMDB (if you can get access later) ─────────────────────
TMDB_API_KEY=your_tmdb_api_key_here
TMDB_REGION=IN

# ── AI Recommendations (optional but recommended) ────────────────────
# Provider: "gemini" | "groq" | "none"
AI_PROVIDER=gemini

# Google Gemini (free): https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Groq (free): https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# ── Android (Capacitor) ───────────────────────────────────────────────
# Dev: http://YOUR_PC_LAN_IP:3000  |  Prod: https://your-app.vercel.app
CAPACITOR_SERVER_URL=http://192.168.1.100:3000
